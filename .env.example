# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development

# ── Secrets (safe defaults for local dev) ───────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production-min-32chars
INTERNAL_TOKEN=dev-internal-token-change-in-production

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=pairexx
POSTGRES_PASSWORD=pairexx_pass
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_pass
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1

# ── NATS ─────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── Service ports ────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MATCHMAKING_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083
MODERATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

API_GATEWAY_BIND_ADDRESS=0.0.0.0

# ── Repository drivers ───────────────────────────────────────────────
USER_REPO_DRIVER=postgres
MATCHMAKING_REPO_DRIVER=redis
CHAT_REPO_DRIVER=postgres
MODERATION_REPO_DRIVER=postgres

# ── CORS ─────────────────────────────────────────────────────────────
DEV_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Nginx Proxy Manager ──────────────────────────────────────────────
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# ── TURN/STUN ────────────────────────────────────────────────────────
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
TURN_USER=turnuser
TURN_PASSWORD=turnpass
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=pairexx.local
