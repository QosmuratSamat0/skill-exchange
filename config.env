# =============================================================================
# Pairexx — Service Configuration Environment  (config.env.example)
# =============================================================================
# TEMPLATE — safe to commit.  Copy to config.env and fill in real values.
#
#   cp config.env.example config.env
#
# This file supplements .env (DB credentials, JWT secrets, Redis password).
# It owns SMTP credentials and inter-service routing URLs.
#
# The root launcher (go run .) loads files in this order:
#   1. .env          ← infrastructure secrets
#   2. config.env    ← service credentials & routing  (this file)
#   3. applyDefaults ← compiled fallbacks for anything still unset
# =============================================================================


# ── SMTP / Gmail ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=baykatv5@gmail.com
SMTP_PASSWORD="imjl acvw asix opqm"

# ── Inter-service Routing ─────────────────────────────────────────────────────
# Keep these exactly as they are if running bare-metal on your localhost
USER_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Docker / container networking — use Docker service-name DNS:
# USER_SERVICE_URL=http://user-service:8081
# NOTIFICATION_SERVICE_URL=http://notification-service:8085
