      }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "style": "dark",
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {}
  },
  "overwrite": true
}
